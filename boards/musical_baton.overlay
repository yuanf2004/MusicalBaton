/* Musical Baton custom PCB hardware map.
 *
 * This overlay is for the actual PCB, not the nRF52840 development kit.
 * While the project still builds on the nRF52840 DK board definition, select
 * this file explicitly as DTC_OVERLAY_FILE for a PCB build.
 */

#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	aliases {
		baton-button = &baton_button;
		ble-led = &ble_led;
		rgb-red-led = &rgb_red_led;
		rgb-green-led = &rgb_green_led;
		rgb-blue-led = &rgb_blue_led;
	};

	baton-buttons {
		compatible = "gpio-keys";

		baton_button: button_0 {
			/* SW1 pulls P0.19 low when pressed. */
			gpios = <&gpio0 19 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Baton user button";
		};
	};

	baton-leds {
		compatible = "gpio-leds";

		/* The separate BLE LED has its cathode connected to ground. */
		ble_led: ble_led {
			gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
			label = "Bluetooth status LED";
		};

		/* The RGB LED is common-anode, so each color is active-low. */
		rgb_red_led: rgb_red_led {
			gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;
			label = "RGB red";
		};

		rgb_green_led: rgb_green_led {
			gpios = <&gpio0 23 GPIO_ACTIVE_LOW>;
			label = "RGB green";
		};

		rgb_blue_led: rgb_blue_led {
			gpios = <&gpio0 24 GPIO_ACTIVE_LOW>;
			label = "RGB blue";
		};
	};

	/* Application-accessible PCB signals that do not have device drivers yet. */
	zephyr,user {
		io-channels = <&adc 0>;
		io-channel-names = "battery";
		charge-status-gpios = <&gpio0 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		imu-int2-gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
	};
};

/* The PCB uses P0.27 for SDA and P0.26 for SCL. */
&pinctrl {
	baton_i2c0_default: baton_i2c0_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 27)>,
				<NRF_PSEL(TWIM_SCL, 0, 26)>;
		};
	};

	baton_i2c0_sleep: baton_i2c0_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 27)>,
				<NRF_PSEL(TWIM_SCL, 0, 26)>;
			low-power-enable;
		};
	};
};

&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";

	pinctrl-0 = <&baton_i2c0_default>;
	pinctrl-1 = <&baton_i2c0_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_FAST>;

	/* LSM6DSOX SA0 is tied low on the PCB, selecting address 0x6A. */
	lsm6dsox: imu@6a {
		compatible = "st,lsm6dso";
		reg = <0x6a>;
		status = "okay";

		irq-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
		int-pin = <1>;
	};
};

/* P0.02 is AIN0 and measures the midpoint of the 1 MOhm/1 MOhm divider. */
&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN0>;
		zephyr,resolution = <12>;
	};
};

/* These peripherals belong to the development kit and are absent on the PCB. */
&qspi {
	status = "disabled";
};

&led0 {
	status = "disabled";
};

&led1 {
	status = "disabled";
};

&led2 {
	status = "disabled";
};

&led3 {
	status = "disabled";
};

&button0 {
	status = "disabled";
};

&button1 {
	status = "disabled";
};

&button2 {
	status = "disabled";
};

&button3 {
	status = "disabled";
};
