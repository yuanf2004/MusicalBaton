#include <zephyr/dt-bindings/sensor/lsm6dso.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	aliases {
		baton-imu = &lsm6dsox;
		/* Development only: DK Button 1 on P0.11.
		 * The custom baton PCB maps its user button to P0.19.
		 */
		baton-button = &button0;

		/* Development only: external LED on exposed Arduino A0 / P0.03. */
		ble-led = &development_ble_led;
	};

	development-leds {
		compatible = "pwm-leds";

		development_ble_led: bluetooth_led {
			/* LED anode -> resistor -> P0.03; cathode -> GND. */
			pwms = <&pwm0 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
			label = "Development Bluetooth LED";
		};
	};
};


&pinctrl {
	baton_pwm0_default: baton_pwm0_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 3)>;
		};
	};

	baton_pwm0_sleep: baton_pwm0_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 3)>;
			low-power-enable;
		};
	};

	/* DK IMU wiring now matches the PCB: SDA P0.27, SCL P0.26. */
	i2c0_default: i2c0_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 27)>,
				<NRF_PSEL(TWIM_SCL, 0, 26)>;
		};
	};

	i2c0_sleep: i2c0_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 27)>,
				<NRF_PSEL(TWIM_SCL, 0, 26)>;
			low-power-enable;
		};
	};
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&baton_pwm0_default>;
	pinctrl-1 = <&baton_pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";

	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";

	clock-frequency = <I2C_BITRATE_FAST>;

	lsm6dsox: imu@6a {
		/* sensor_init() waits for power-up before initializing the driver. */
		zephyr,deferred-init;
		compatible = "st,lsm6dso";
		reg = <0x6a>;
		/* NCS uses the LSM6DSO driver for basic LSM6DSOX motion data. */
		accel-range = <LSM6DSO_DT_FS_4G>;
		accel-odr = <LSM6DSO_DT_ODR_52Hz>;
		/* Accelerometer LPF2: 52 Hz / 10 = approximately 5.2 Hz. */
		accel-lp-filter = <LSM6DSO_DT_LP_ODR_DIV_10>;
		gyro-range = <LSM6DSO_DT_FS_1000DPS>;
		gyro-odr = <LSM6DSO_DT_ODR_52Hz>;
		status = "okay";
	};
};
